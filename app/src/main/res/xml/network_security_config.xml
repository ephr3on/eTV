<?xml version="1.0" encoding="utf-8"?>
<!--
  Older Android TVs don't know Let's Encrypt's newer roots yet, and some sites eTV downloads from
  (archive.org's file servers: the athan recordings and the dua) already use them. So eTV also
  trusts Let's Encrypt's own roots, from res/raw, alongside the TV's usual ones. Nothing else changes:
  every connection is still HTTPS and still checked.

  The one exception is the TV itself: AirPlay videos (from Safari, YouTube, ...) are handed to the
  player through a small server inside eTV, at http://localhost, which never leaves the TV.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/isrg_root_ye" />
            <certificates src="@raw/isrg_root_yr" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
